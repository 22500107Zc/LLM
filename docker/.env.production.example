# =============================================================================
# Managed Business AI Operations Platform - deployment configuration
#
# Copy to docker/.env and fill in. One business = one dedicated deployment, so
# every value here describes THIS customer only.
#
# NEVER commit a filled-in copy of this file. It contains secrets.
# Generate each secret with:  openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - the deployment refuses to start in production without these
# -----------------------------------------------------------------------------
NODE_ENV=production
SERVER_PORT=3001
STORAGE_DIR=/app/server/storage

# Authentication secrets. Must be strong and unique per deployment.
JWT_SECRET=
SIG_KEY=
SIG_SALT=

# The public address customers reach. Used for Stripe return URLs and the
# website-agent embed snippet.
PUBLIC_URL=https://customer.yourdomain.com

# -----------------------------------------------------------------------------
# BRANDING - what the business sees
# -----------------------------------------------------------------------------
APP_NAME=Acme AI Operations
COMPANY_NAME=Acme Corporation
LEGAL_COMPANY_NAME=Acme Corporation Ltd
APP_TAGLINE=Your company's private AI operations platform
APP_LOGO=
APP_ICON=
PRIMARY_DOMAIN=customer.yourdomain.com
PRIMARY_COLOR=#2563eb
SUPPORT_EMAIL=support@yourdomain.com

# -----------------------------------------------------------------------------
# CUSTOMER IDENTITY - never hardcode these in source
# -----------------------------------------------------------------------------
CUSTOMER_NAME=Acme Corporation
CUSTOMER_DOMAIN=customer.yourdomain.com
CUSTOMER_LOGO=

# -----------------------------------------------------------------------------
# INCLUDED OPERATIONAL LIMITS (safeguards, not pricing tiers)
# -----------------------------------------------------------------------------
MAX_USERS=50
MAX_PUBLIC_AGENTS=3
STORAGE_LIMIT_GB=25

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Production must run authenticated. Leave this on.
REQUIRE_MULTI_USER_MODE=true

# A website agent with no domain allowlist would answer from ANY site.
# Leave this on so an allowlist is mandatory.
EMBED_REQUIRE_ALLOWLIST=true

# Per-IP limits for public website-agent traffic.
PUBLIC_RATE_LIMIT_PER_MINUTE=30
PUBLIC_RATE_LIMIT_BURST=10

# Shared token for the external uptime probe at /api/platform/health/probe.
HEALTHCHECK_TOKEN=

# Leave OFF. When on, a customer-configured webhook could reach internal
# addresses including the cloud metadata service.
ALLOW_PRIVATE_NETWORK_WEBHOOKS=false

# No usage data leaves this deployment.
DISABLE_TELEMETRY=true

# -----------------------------------------------------------------------------
# STRIPE BILLING
# Product: "Managed Business AI Platform" - $3,888.88 USD / month recurring.
# The secret key is server-side only and is never sent to the browser.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRODUCT_ID=
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=

# Set at provisioning time to bind this deployment to the customer's Stripe
# objects. Can also be set from the Billing page.
STRIPE_CUSTOMER_ID=
STRIPE_SUBSCRIPTION_ID=

# Subscription enforcement. Turn on only once billing is live and verified.
# A failed payment never deletes data - it warns, then suspends AI usage.
BILLING_ENFORCEMENT_ENABLED=false
BILLING_GRACE_PERIOD_DAYS=7
BILLING_RESTRICT_INTERNAL_CHAT=true
BILLING_RESTRICT_PUBLIC_AGENTS=true
BILLING_RESTRICT_AUTOMATIONS=true

# -----------------------------------------------------------------------------
# NOTIFICATIONS (lead and escalation delivery by email)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_NOTIFICATION_EMAIL=
ESCALATION_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# AI PROVIDER - supply the CUSTOMER'S OWN credentials.
# Model usage is billed by their provider, not absorbed into the subscription.
# Uncomment the block for the provider in use.
# -----------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

LLM_PROVIDER=openai
OPEN_AI_KEY=
OPEN_MODEL_PREF=gpt-4o

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_PREF=claude-sonnet-5

# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# OPEN_MODEL_PREF=

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# LLM_PROVIDER=bedrock
# AWS_BEDROCK_LLM_ACCESS_KEY_ID=
# AWS_BEDROCK_LLM_ACCESS_KEY=
# AWS_BEDROCK_LLM_REGION=us-west-2

# -----------------------------------------------------------------------------
# EMBEDDING + VECTOR STORE
# Defaults keep everything inside this deployment. Change only if required.
# -----------------------------------------------------------------------------
EMBEDDING_ENGINE=native
VECTOR_DB=lancedb

# -----------------------------------------------------------------------------
# BACKUPS
# -----------------------------------------------------------------------------
BACKUP_DIR=/app/backups

# -----------------------------------------------------------------------------
# AGENT SAFETY - high-risk capabilities stay off unless a customer needs them
# -----------------------------------------------------------------------------
# AGENT_ALLOW_SHELL=false
