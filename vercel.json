{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.cjs",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install --omit=optional --legacy-peer-deps --ignore-scripts --no-audit --no-fund",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1769,
      "maxDuration": 60,
      "excludeFiles": "{**/*.md,**/*.map,**/test/**,**/tests/**,**/__tests__/**,**/docs/**,**/example/**,**/examples/**,frontend/**,collector/**,server/storage/**,server/__tests__/**,**/onnxruntime-web/**,**/@lancedb/**,**/@xenova/**,**/chromadb*/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
